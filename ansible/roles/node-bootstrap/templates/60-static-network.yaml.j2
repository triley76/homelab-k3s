network:
  version: 2
  ethernets:
    ens160:
      dhcp4: false
      dhcp6: false
      addresses:
        - "{{ node_ip }}/24"
      routes:
        - to: default
          via: "{{ gateway }}"
      nameservers:
        addresses:
{% for dns in dns_servers %}
          - "{{ dns }}"
{% endfor %}
